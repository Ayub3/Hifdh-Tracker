# Export these variables in your shell; the app does not automatically load .env files.
DATABASE_URL=sqlite:///./hifdh.db
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use true for a disposable ECS/SQLite MVP to create tables at startup.
AUTO_CREATE_SCHEMA=false
# For ECS, use DATABASE_URL=sqlite:////data/hifdh.db and set both frontend origins to HTTPS.
